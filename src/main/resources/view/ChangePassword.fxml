<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="520.0" prefWidth="540.0"
            style="-fx-background-color: #ECF0F1;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="lk.ijse.serenityhealthcenter.controllers.ChangePasswordController">
    <children>
        <VBox spacing="12.0" alignment="TOP_CENTER"
              AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
              AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
            <padding><Insets topRightBottomLeft="25"/></padding>

            <Label text="Account Settings" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"/>
            <Label fx:id="lblLoggedInAs" text="Logged in as: ..."
                   style="-fx-text-fill: #27AE60; -fx-font-size: 12px;"/>
            <Separator/>

            <!-- Change Username section -->
            <Label text="Change Username" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2980B9;"/>
            <GridPane hgap="10.0" vgap="8.0">
                <columnConstraints>
                    <ColumnConstraints minWidth="160.0"/>
                    <ColumnConstraints minWidth="280.0"/>
                </columnConstraints>
                <Label text="Current Username:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="txtCurrentUsername" prefHeight="34.0" editable="false"
                           style="-fx-background-color: #D5DBDB;"
                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="New Username:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="txtNewUsername" promptText="New username (min 4 chars)" prefHeight="34.0"
                           GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            </GridPane>
            <Button fx:id="btnChangeUsername" text="Change Username" onAction="#changeUsername"
                    prefHeight="35.0" prefWidth="200.0"
                    style="-fx-background-color: #2980B9; -fx-text-fill: white; -fx-background-radius: 5;"/>

            <Separator/>

            <!-- Change Password section -->
            <Label text="Change Password" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #8E44AD;"/>
            <GridPane hgap="10.0" vgap="8.0">
                <columnConstraints>
                    <ColumnConstraints minWidth="160.0"/>
                    <ColumnConstraints minWidth="280.0"/>
                </columnConstraints>
                <Label text="Current Password:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <PasswordField fx:id="txtCurrentPassword" promptText="Enter current password" prefHeight="34.0"
                               GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="New Password:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <PasswordField fx:id="txtNewPassword" promptText="New password (min 6 chars)" prefHeight="34.0"
                               GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                <Label text="Confirm Password:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <PasswordField fx:id="txtConfirmPassword" promptText="Confirm new password" prefHeight="34.0"
                               GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            </GridPane>
            <Button fx:id="btnChangePassword" text="Change Password" onAction="#changePassword"
                    prefHeight="35.0" prefWidth="200.0"
                    style="-fx-background-color: #8E44AD; -fx-text-fill: white; -fx-background-radius: 5;"/>

            <Separator/>
            <HBox spacing="10.0" alignment="CENTER">
                <Button fx:id="btnClear" text="Clear" onAction="#clearFields"
                        prefHeight="33.0" prefWidth="110.0"
                        style="-fx-background-color: #95A5A6; -fx-text-fill: white; -fx-background-radius: 5;"/>
                <Button fx:id="btnClose" text="Close" onAction="#closeWindow"
                        prefHeight="33.0" prefWidth="110.0"
                        style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-background-radius: 5;"/>
            </HBox>
        </VBox>
    </children>
</AnchorPane>
