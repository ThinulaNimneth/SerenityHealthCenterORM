<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="500.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="lk.ijse.serenityhealthcenter.controllers.LoginFormController">
    <children>
        <!-- Left Panel -->
        <VBox alignment="CENTER" prefHeight="500.0" prefWidth="380.0"
              style="-fx-background-color: #2C3E50;">
            <padding><Insets topRightBottomLeft="40"/></padding>
            <Label text="Serenity" textFill="WHITE">
                <font><Font name="System Bold" size="36.0"/></font>
            </Label>
            <Label text="Mental Health Therapy Center" textFill="#BDC3C7" wrapText="true" textAlignment="CENTER">
                <font><Font size="16.0"/></font>
            </Label>
            <Label text="Caring for your mind, healing your soul." textFill="#95A5A6"
                   wrapText="true" textAlignment="CENTER">
                <font><Font size="12.0"/></font>
                <VBox.margin><Insets top="20"/></VBox.margin>
            </Label>
        </VBox>

        <!-- Right Panel -->
        <VBox alignment="CENTER" layoutX="380.0" prefHeight="500.0" prefWidth="420.0"
              style="-fx-background-color: #ECF0F1;" spacing="15.0">
            <padding><Insets topRightBottomLeft="40"/></padding>

            <Label text="Welcome Back" style="-fx-font-weight: bold; -fx-font-size: 24px;"/>
            <Label text="Sign in to your account" style="-fx-text-fill: #7F8C8D;"/>

            <TextField fx:id="txtUsername" promptText="Username" prefHeight="40.0" prefWidth="300.0"
                       style="-fx-background-radius: 5;"/>

            <StackPane prefWidth="300.0">
                <PasswordField fx:id="txtPassword" prefHeight="40.0" prefWidth="300.0"
                               promptText="Password" style="-fx-background-radius: 5;"/>
                <TextField fx:id="txtPasswordVisible" prefHeight="40.0" prefWidth="300.0"
                           promptText="Password" style="-fx-background-radius: 5;" visible="false"/>
                <Button fx:id="btnTogglePassword" text="🙈" onAction="#togglePasswordVisibility"
                        style="-fx-background-color: transparent;" prefWidth="40.0">
                    <StackPane.margin><Insets right="5.0"/></StackPane.margin>
                    <StackPane.alignment><javafx.geometry.Pos fx:constant="CENTER_RIGHT"/></StackPane.alignment>
                </Button>
            </StackPane>

            <Button fx:id="btnLogin" text="Login" onAction="#loginOnAction"
                    prefHeight="40.0" prefWidth="300.0"
                    style="-fx-background-color: #2C3E50; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-size: 14px;"/>

            <HBox alignment="CENTER" spacing="5.0">
                <Label text="Don't have an account?" style="-fx-text-fill: #7F8C8D;"/>
                <Hyperlink fx:id="registerLink" text="Register" onAction="#registrationOnAction"/>
            </HBox>
        </VBox>
    </children>
</AnchorPane>
